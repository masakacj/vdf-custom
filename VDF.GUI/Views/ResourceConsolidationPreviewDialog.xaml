<Window
    x:Class="VDF.GUI.Views.ResourceConsolidationPreviewDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="文件夹合并预览"
    Width="1240"
    Height="860"
    MinWidth="980"
    MinHeight="680"
    CanResize="True"
    WindowStartupLocation="CenterOwner">
    <Grid Margin="18" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="12">
        <DockPanel LastChildFill="True">
            <Border DockPanel.Dock="Right" Padding="9,4" CornerRadius="7"
                    Background="{DynamicResource VdfGoodSoftBrush}"
                    BorderBrush="{DynamicResource VdfGoodBorderBrush}" BorderThickness="1">
                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource VdfGoodBrush}" Text="预演 + 人工审核，不会立即改文件" />
            </Border>
            <StackPanel Spacing="4">
                <TextBlock FontSize="19" FontWeight="SemiBold" Text="文件夹合并预览" />
                <TextBlock x:Name="ScopeText" FontSize="12" Opacity="0.72" TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Padding="11" CornerRadius="8"
                Background="{DynamicResource VdfGoodSoftBrush}"
                BorderBrush="{DynamicResource VdfGoodBorderBrush}" BorderThickness="1">
            <TextBlock FontSize="11.5" TextWrapping="Wrap"
                       Text="自动区只包含通过严格置信门槛的“确认 BEST”，其余副本已预选为可清理；任何关键元数据缺失、质量指标冲突或其他疑点都会进入人工审核。人工区仍给出 ★ 推荐 BEST，但只有你明确确认保留副本后才会纳入合并。" />
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="10">
            <Border Padding="12" CornerRadius="8" BorderBrush="{DynamicResource VdfMutedBorderBrush}" BorderThickness="1">
                <StackPanel Spacing="5">
                    <TextBlock FontSize="11" Opacity="0.62" Text="① 合并前 · 索引范围" />
                    <TextBlock x:Name="BeforeText" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Padding="12" CornerRadius="8"
                    Background="{DynamicResource VdfWarnSoftBrush}"
                    BorderBrush="{DynamicResource VdfWarnBorderBrush}" BorderThickness="1">
                <StackPanel Spacing="5">
                    <TextBlock FontSize="11" Opacity="0.72" Text="② 本次增 / 换 / 删 / 跳过" />
                    <TextBlock x:Name="ChangesText" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Padding="12" CornerRadius="8"
                    Background="{DynamicResource VdfGoodSoftBrush}"
                    BorderBrush="{DynamicResource VdfGoodBorderBrush}" BorderThickness="1">
                <StackPanel Spacing="5">
                    <TextBlock FontSize="11" Opacity="0.72" Text="③ 合并后 · 计划目标" />
                    <TextBlock x:Name="AfterText" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <TabControl x:Name="DetailTabs" Grid.Row="3" MinHeight="390">
            <TabItem x:Name="ReviewTab" Header="合并审核">
                <ScrollViewer Margin="8" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="10">
                        <Expander x:Name="AutomaticExpander" IsExpanded="False">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock x:Name="AutomaticHeader" FontWeight="SemiBold" Text="系统确认可合并" />
                                    <TextBlock FontSize="11" Opacity="0.62" VerticalAlignment="Center" Text="默认收起 · loser 已预选删除" />
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel x:Name="AutomaticPanel" Margin="0,8,0,0" Spacing="9" />
                        </Expander>

                        <Border Height="1" Background="{DynamicResource VdfMutedBorderBrush}" />

                        <Expander x:Name="ManualExpander" IsExpanded="True">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock x:Name="ManualHeader" FontWeight="SemiBold" Text="需要人工选择" />
                                    <TextBlock FontSize="11" Opacity="0.62" VerticalAlignment="Center" Text="默认展开 · 直接查看 thumbnail 和质量信息" />
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel Margin="0,8,0,0" Spacing="7">
                                <TextBlock FontSize="11" Opacity="0.68" TextWrapping="Wrap"
                                           Text="每组默认突出显示系统推荐 BEST，但不会自动确认。点击其他候选会直接切换保留副本；若仍采用推荐项，请点击“确认当前选择”。确认后该组的其余副本才进入可清理统计。" />
                                <StackPanel x:Name="ManualReviewPanel" Spacing="9" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="DeletionTab" Header="确认删除 / 释放">
                <Grid Margin="8" RowDefinitions="Auto,*" RowSpacing="8">
                    <TextBlock FontSize="11" Opacity="0.68" TextWrapping="Wrap"
                               Text="这里只列当前已经确认可清理的重复副本。系统确认区默认纳入；人工区只有你确认保留副本后才加入。目标位旧副本在 BEST 校验成功后直接替换，其余副本在合并成功后标记为待删除。" />
                    <TextBox x:Name="DeletionTextBox" Grid.Row="1"
                             IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                             FontFamily="Cascadia Mono,Consolas,monospace" FontSize="11.5" Padding="10"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </Grid>
            </TabItem>

            <TabItem Header="最终目录树">
                <Grid Margin="8" RowDefinitions="Auto,*" RowSpacing="8">
                    <WrapPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,14,0" FontSize="10.8" Foreground="{DynamicResource VdfGoodBrush}" Text="＋ 新增" />
                        <TextBlock Margin="0,0,14,0" FontSize="10.8" Foreground="{DynamicResource VdfGoodBrush}" Text="↑ BEST替换" />
                        <TextBlock Margin="0,0,14,0" FontSize="10.8" Opacity="0.7" Text="＝ 保留" />
                        <TextBlock FontSize="10.8" Foreground="{DynamicResource VdfWarnBrush}" Text="⚠ 未确认/冲突不进入自动树" />
                    </WrapPanel>
                    <TextBox x:Name="TreeTextBox" Grid.Row="1"
                             IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                             FontFamily="Cascadia Mono,Consolas,monospace" FontSize="11.5" Padding="10"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </Grid>
            </TabItem>

            <TabItem Header="A / B 文件夹对照">
                <Grid Margin="8" RowDefinitions="Auto,*" RowSpacing="8">
                    <TextBlock FontSize="11" Opacity="0.68" TextWrapping="Wrap"
                               Text="路径、文件数、大小、双向重叠率、覆盖率，以及当前确认/待复核 BEST 情况。目标 ← 来源表示实际合并方向。" />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="RelationText" FontSize="11.7" LineHeight="19" TextWrapping="Wrap" />
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="4" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" MaxWidth="820" VerticalAlignment="Center" FontSize="11" Opacity="0.64" TextWrapping="Wrap"
                       Text="只有系统确认 BEST 和你在人工区明确确认过的资源组才会变化。未审核的推荐项、无关文件冲突、覆盖不足及任何安全校验失败项都保持原位置。" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                <Button MinWidth="100" IsCancel="True" Click="OnCancelClicked" Content="返回修改" />
                <Button MinWidth="150" Classes="accent" IsDefault="True" Click="OnStartClicked" Content="确认并安全合并" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>