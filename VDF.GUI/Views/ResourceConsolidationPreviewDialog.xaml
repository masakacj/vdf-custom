<Window
    x:Class="VDF.GUI.Views.ResourceConsolidationPreviewDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="文件夹合并预览"
    Width="1120"
    Height="820"
    MinWidth="900"
    MinHeight="650"
    CanResize="True"
    WindowStartupLocation="CenterOwner">
    <Grid Margin="18" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="12">
        <DockPanel LastChildFill="True">
            <Border DockPanel.Dock="Right" Padding="9,4" CornerRadius="7"
                    Background="{DynamicResource VdfGoodSoftBrush}"
                    BorderBrush="{DynamicResource VdfGoodBorderBrush}" BorderThickness="1">
                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource VdfGoodBrush}" Text="预演 + 人工复核，不会立即改文件" />
            </Border>
            <StackPanel Spacing="4">
                <TextBlock FontSize="19" FontWeight="SemiBold" Text="文件夹合并预览" />
                <TextBlock x:Name="ScopeText" FontSize="12" Opacity="0.72" TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Padding="11" CornerRadius="8"
                Background="{DynamicResource VdfGoodSoftBrush}"
                BorderBrush="{DynamicResource VdfGoodBorderBrush}" BorderThickness="1">
            <TextBlock FontSize="11.5" TextWrapping="Wrap"
                       Text="每个资源组都有一个系统推荐 BEST。确认 BEST 会直接进入自动计划；置信不足的推荐 BEST 会进入“人工复核”，可在本窗口接受推荐或改选其他副本。人工选择完成后，释放空间、删除明细和最终目录树会立即重算。" />
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="10">
            <Border Padding="12" CornerRadius="8" BorderBrush="{DynamicResource VdfMutedBorderBrush}" BorderThickness="1">
                <StackPanel Spacing="5">
                    <TextBlock FontSize="11" Opacity="0.62" Text="① 合并前 · VDF 索引范围" />
                    <TextBlock x:Name="BeforeText" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Padding="12" CornerRadius="8"
                    Background="{DynamicResource VdfWarnSoftBrush}"
                    BorderBrush="{DynamicResource VdfWarnBorderBrush}" BorderThickness="1">
                <StackPanel Spacing="5">
                    <TextBlock FontSize="11" Opacity="0.72" Text="② 本次增 / 换 / 删 / 跳过" />
                    <TextBlock x:Name="ChangesText" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Padding="12" CornerRadius="8"
                    Background="{DynamicResource VdfGoodSoftBrush}"
                    BorderBrush="{DynamicResource VdfGoodBorderBrush}" BorderThickness="1">
                <StackPanel Spacing="5">
                    <TextBlock FontSize="11" Opacity="0.72" Text="③ 合并后 · 计划目标" />
                    <TextBlock x:Name="AfterText" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <TabControl x:Name="DetailTabs" Grid.Row="3" MinHeight="360">
            <TabItem x:Name="ManualTab" Header="人工复核">
                <Grid Margin="8" RowDefinitions="Auto,*" RowSpacing="8">
                    <TextBlock FontSize="11" Opacity="0.68" TextWrapping="Wrap"
                               Text="推荐 BEST 已默认选中。只有勾选“采用此选择”或主动改选其他副本后，该组才会进入本次合并。未确认的组保持原样。" />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="ManualReviewPanel" Spacing="9" />
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem x:Name="DeletionTab" Header="确认删除 / 释放">
                <Grid Margin="8" RowDefinitions="Auto,*" RowSpacing="8">
                    <TextBlock FontSize="11" Opacity="0.68" TextWrapping="Wrap"
                               Text="这里只列系统当前确认可清理的重复副本。目标位旧副本在 BEST 校验成功后直接替换；其余副本在合并成功后标为待删除。人工复核选择变化时本页同步更新。" />
                    <TextBox x:Name="DeletionTextBox" Grid.Row="1"
                             IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                             FontFamily="Cascadia Mono,Consolas,monospace" FontSize="11.5" Padding="10"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </Grid>
            </TabItem>

            <TabItem Header="最终目录树">
                <Grid Margin="8" RowDefinitions="Auto,*" RowSpacing="8">
                    <WrapPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,14,0" FontSize="10.8" Foreground="{DynamicResource VdfGoodBrush}" Text="＋ 新增" />
                        <TextBlock Margin="0,0,14,0" FontSize="10.8" Foreground="{DynamicResource VdfGoodBrush}" Text="↑ BEST替换" />
                        <TextBlock Margin="0,0,14,0" FontSize="10.8" Opacity="0.7" Text="＝ 保留" />
                        <TextBlock FontSize="10.8" Foreground="{DynamicResource VdfWarnBrush}" Text="⚠ 未确认/冲突不进入自动树" />
                    </WrapPanel>
                    <TextBox x:Name="TreeTextBox" Grid.Row="1"
                             IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                             FontFamily="Cascadia Mono,Consolas,monospace" FontSize="11.5" Padding="10"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </Grid>
            </TabItem>

            <TabItem Header="A / B 文件夹对照">
                <Grid Margin="8" RowDefinitions="Auto,*" RowSpacing="8">
                    <TextBlock FontSize="11" Opacity="0.68" TextWrapping="Wrap"
                               Text="路径、文件数、大小、双向重叠率、覆盖率，以及当前确认/待复核 BEST 情况。目标 ← 来源表示实际合并方向。" />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="RelationText" FontSize="11.7" LineHeight="19" TextWrapping="Wrap" />
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="4" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" MaxWidth="735" VerticalAlignment="Center" FontSize="11" Opacity="0.64" TextWrapping="Wrap"
                       Text="只有预览中已经进入自动计划的文件才会变化。未接受的人工推荐、无关文件冲突、覆盖不足及任何安全校验失败项都保持原位置。" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                <Button MinWidth="100" IsCancel="True" Click="OnCancelClicked" Content="返回修改" />
                <Button MinWidth="150" Classes="accent" IsDefault="True" Click="OnStartClicked" Content="确认并安全合并" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>