<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:actipro="http://schemas.actiprosoftware.com/avaloniaui"
        xmlns:vm="clr-namespace:VDF.GUI.ViewModels"
        xmlns:data="clr-namespace:VDF.GUI.Data"
        xmlns:app="clr-namespace:VDF.GUI;assembly=VDF.GUI"
        x:Class="VDF.GUI.Views.BlacklistManagerView"
        x:DataType="vm:BlacklistManagerVM"
        Width="860" Height="560" MinWidth="550" MinHeight="380"
        Icon="/Assets/icon.ico"
        WindowStartupLocation="CenterOwner"
        Title="管理黑名单与路径排除">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0"
                   Text="{Binding StatusMessage}"
                   TextWrapping="Wrap"
                   IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <Button DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,10,0,0"
                Content="{Binding Source={x:Static app:App.Lang}, Path=[Dialog.Close]}"
                MinWidth="90" IsCancel="True" Click="Close_Click" />
        <TabControl x:Name="ExclusionTabs">
            <TabItem Header="结果目录排除">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,10">
                        <TextBlock Text="在结果中隐藏指定文件夹及所有子目录的文件，不删除文件、不改动扫描数据库。"
                                   TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox MinWidth="260" Width="350"
                                     Text="{Binding NewExcludedPath, Mode=TwoWay}"
                                     Watermark="完整目录，例如 Y:\pipa\pipa2\..." />
                            <CheckBox VerticalAlignment="Center"
                                      IsChecked="{Binding NewSkipScan, Mode=TwoWay}"
                                      Content="以后扫描跳过" />
                            <Button Content="添加排除" Command="{Binding AddResultPathCommand}" />
                        </StackPanel>
                        <TextBlock Opacity="0.65" TextWrapping="Wrap"
                                   Text="“以后扫描跳过”仅影响下一次扫描；关闭后只隐藏结果。扫描设置中已有的排除项仍保留在扫描设置页。" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,9">
                        <TextBox Width="285" Text="{Binding ResultPathQuery, Mode=TwoWay}" Watermark="搜索结果排除目录路径" />
                        <Button Content="搜索" Command="{Binding SearchResultPathCommand}" />
                        <Button Content="上一页" Command="{Binding PreviousResultPathPageCommand}" IsEnabled="{Binding CanPreviousResultPathPage}" />
                        <Button Content="下一页" Command="{Binding NextResultPathPageCommand}" IsEnabled="{Binding CanNextResultPathPage}" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" Text="{Binding ResultPathPageSummary}" />
                    <Button DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,10,0,0"
                            Content="移除选中排除项"
                            Command="{Binding RemoveResultPathsCommand}"
                            CommandParameter="{Binding ElementName=ResultPathList, Path=SelectedItems}" />
                    <Border Padding="4" CornerRadius="8"
                            Background="{actipro:ThemeResource Container1BackgroundBrush}"
                            BorderBrush="{actipro:ThemeResource Container3BorderBrush}"
                            BorderThickness="1">
                        <ListBox x:Name="ResultPathList" Background="Transparent"
                                 ItemsSource="{Binding VisiblePathRules}" SelectionMode="Multiple">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="data:ResultPathExclusion">
                                    <Grid ColumnDefinitions="*,Auto" Margin="2" ColumnSpacing="12">
                                        <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                                   Text="{Binding Path}" TextWrapping="Wrap" />
                                        <CheckBox Grid.Column="1" VerticalAlignment="Center"
                                                  Content="以后扫描跳过"
                                                  IsChecked="{Binding SkipScan, Mode=TwoWay}"
                                                  Click="OnSkipScanClick" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </DockPanel>
            </TabItem>
            <TabItem Header="扫描目录排除（原版）">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,10"
                               TextWrapping="Wrap"
                               Text="原版扫描目录黑名单：只影响以后扫描，不会隐藏当前结果。也可以在扫描设置页管理。这里可查看全部已有规则（包括通配符规则）。" />
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
                        <TextBox Width="480" MinWidth="260" Text="{Binding ScanDirectoryInput, Mode=TwoWay}"
                                 Watermark="输入完整目录路径（不允许排除磁盘根目录）" />
                        <Button Content="添加目录" Command="{Binding AddScanDirectoryCommand}" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                        <TextBox Width="285" Text="{Binding ScanDirectoryQuery, Mode=TwoWay}" Watermark="搜索扫描目录黑名单" />
                        <Button Content="搜索" Command="{Binding SearchScanDirectoryCommand}" />
                        <Button Content="上一页" Command="{Binding PreviousScanDirectoryPageCommand}" IsEnabled="{Binding CanPreviousScanDirectoryPage}" />
                        <Button Content="下一页" Command="{Binding NextScanDirectoryPageCommand}" IsEnabled="{Binding CanNextScanDirectoryPage}" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" Text="{Binding ScanDirectoryPageSummary}" />
                    <Button DockPanel.Dock="Bottom" Margin="0,10,0,0" HorizontalAlignment="Right"
                            Content="移除选中目录"
                            Command="{Binding RemoveScanDirectoriesCommand}"
                            CommandParameter="{Binding ElementName=ScanDirectoriesList, Path=SelectedItems}" />
                    <Border Padding="4" CornerRadius="8"
                            Background="{actipro:ThemeResource Container1BackgroundBrush}"
                            BorderBrush="{actipro:ThemeResource Container3BorderBrush}"
                            BorderThickness="1">
                        <ListBox x:Name="ScanDirectoriesList" ItemsSource="{Binding VisibleScanDirectories}"
                                 Background="Transparent" SelectionMode="Multiple">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="4,3" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </DockPanel>
            </TabItem>
            <TabItem Header="单文件排除（原版）">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="查询数据库中原版“从列表移除并排除以后扫描”的文件记录（ManuallyExcluded）。搜索不扫描硬盘；解除后将保存原数据库，文件需下次扫描才会重新参与匹配。" />
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                        <TextBox Width="410" MinWidth="200" Text="{Binding ExcludedFileQuery, Mode=TwoWay}"
                                 Watermark="输入文件路径关键词" />
                        <Button Content="搜索" Command="{Binding SearchExcludedFilesCommand}"
                                IsEnabled="{Binding !IsLoadingExcludedFiles}" />
                        <Button Content="加载 / 刷新记录" Command="{Binding LoadExcludedFilesCommand}"
                                IsEnabled="{Binding !IsLoadingExcludedFiles}" />
                        <Button Content="上一页" Command="{Binding PreviousExcludedFilePageCommand}"
                                IsEnabled="{Binding CanPreviousExcludedFilePage}" />
                        <Button Content="下一页" Command="{Binding NextExcludedFilePageCommand}"
                                IsEnabled="{Binding CanNextExcludedFilePage}" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" TextWrapping="Wrap"
                               Text="{Binding ExcludedFileSummary}" />
                    <Button DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,10,0,0"
                            Content="解除选中文件的扫描排除"
                            IsEnabled="{Binding !IsLoadingExcludedFiles}"
                            Command="{Binding RestoreExcludedFilesCommand}"
                            CommandParameter="{Binding ElementName=ExcludedFilesList, Path=SelectedItems}" />
                    <Border Padding="4" CornerRadius="8"
                            Background="{actipro:ThemeResource Container1BackgroundBrush}"
                            BorderBrush="{actipro:ThemeResource Container3BorderBrush}"
                            BorderThickness="1">
                        <ListBox x:Name="ExcludedFilesList" ItemsSource="{Binding ExcludedFiles}"
                                 Background="Transparent" SelectionMode="Multiple">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="4,3" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </DockPanel>
            </TabItem>
            <TabItem Header="误判重复组">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" TextWrapping="Wrap"
                               Opacity="0.8"
                               Text="{Binding Source={x:Static app:App.Lang}, Path=[BlacklistManager.Description]}" />
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" FontWeight="SemiBold"
                               Text="{Binding GroupCountText}" />
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                        <TextBox Width="285" Text="{Binding GroupQuery, Mode=TwoWay}" Watermark="按组内文件路径关键词查找" />
                        <Button Content="搜索" Command="{Binding SearchGroupCommand}" IsEnabled="{Binding !IsLoadingGroups}" />
                        <Button Content="上一页" Command="{Binding PreviousGroupPageCommand}" IsEnabled="{Binding CanPreviousGroupPage}" />
                        <Button Content="下一页" Command="{Binding NextGroupPageCommand}" IsEnabled="{Binding CanNextGroupPage}" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" Text="{Binding GroupPageSummary}" />
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" Opacity="0.6"
                               IsVisible="{Binding IsEmpty}"
                               Text="{Binding Source={x:Static app:App.Lang}, Path=[BlacklistManager.Empty]}" />
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
                        <Button Content="{Binding Source={x:Static app:App.Lang}, Path=[BlacklistManager.UnmarkSelected]}"
                                Command="{Binding UnmarkSelectedCommand}"
                                CommandParameter="{Binding ElementName=EntriesListBox, Path=SelectedItems}" />
                        <Button Content="{Binding Source={x:Static app:App.Lang}, Path=[BlacklistManager.PruneMissing]}"
                                Command="{Binding PruneMissingFilesCommand}" />
                        <Button Content="{Binding Source={x:Static app:App.Lang}, Path=[Dialog.ClearAll]}"
                                Command="{Binding ClearAllCommand}" />
                    </StackPanel>
                    <Border Padding="4" CornerRadius="8"
                            Background="{actipro:ThemeResource Container1BackgroundBrush}"
                            BorderBrush="{actipro:ThemeResource Container3BorderBrush}"
                            BorderThickness="1">
                        <ListBox x:Name="EntriesListBox" Background="Transparent"
                                 ItemsSource="{Binding Entries}" SelectionMode="Multiple">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:BlacklistEntryVM">
                                    <TextBlock Margin="2" FontSize="12" TextWrapping="Wrap"
                                               Text="{Binding PathsDisplay}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
