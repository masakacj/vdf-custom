<Window
    x:Class="VDF.GUI.Views.ResourceConsolidationDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="资源整合"
    Width="620"
    MinWidth="520"
    CanResize="false"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner">
    <StackPanel Margin="18" Spacing="12">
        <TextBlock FontSize="14" FontWeight="SemiBold" Text="整合目标" />
        <TextBlock x:Name="SummaryText" FontSize="11.5" Opacity="0.72" TextWrapping="Wrap" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox
                x:Name="DestinationTextBox"
                MinHeight="34"
                VerticalContentAlignment="Center"
                Watermark="输入目标目录，或点击浏览选择" />
            <Button
                Grid.Column="1"
                MinWidth="82"
                Click="OnBrowseClicked"
                Content="浏览…" />
        </Grid>
        <Border Padding="10" CornerRadius="6" Background="{DynamicResource VdfMutedSoftBrush}">
            <TextBlock
                FontSize="11.5"
                Opacity="0.75"
                TextWrapping="Wrap"
                Text="会保留每个系列根目录以下的相对目录结构，例如日期、主题、版本等子文件夹。目标路径已存在不同文件时不会覆盖，也不会自动改名；该项将留给人工处理。" />
        </Border>
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
            <Button MinWidth="92" IsCancel="True" Click="OnCancelClicked" Content="取消" />
            <Button MinWidth="110" Classes="accent" IsDefault="True" Click="OnOkClicked" Content="预览整合" />
        </StackPanel>
    </StackPanel>
</Window>