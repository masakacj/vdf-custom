<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VDF.GUI.ViewModels"
        x:Class="VDF.GUI.Views.FolderMergeDialog"
        x:DataType="vm:FolderMergeDialogVM"
        Width="800" Height="415" MinWidth="620" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Title="合并所勾选文件所在文件夹">
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Bottom" Spacing="10" Margin="0,14,0,0">
      <TextBlock Text="{Binding ErrorText}" Foreground="OrangeRed" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
        <Button MinWidth="100" Content="取消" IsCancel="True" Click="Cancel_Click" />
        <Button MinWidth="140" Content="检查并继续…" IsDefault="True" Click="Confirm_Click" />
      </StackPanel>
    </StackPanel>
    <StackPanel Spacing="13">
      <TextBlock FontSize="15" FontWeight="SemiBold" Text="将源文件夹的内容合并进目标文件夹" />
      <TextBlock Text="以下目录来自当前勾选的两份文件，均可直接修改。移动的是源目录的全部文件（含子目录），而不是只移动两份勾选文件。"
                 Opacity="0.8" TextWrapping="Wrap" />
      <TextBlock Text="源文件夹（合并后清空的目录）" FontWeight="SemiBold" />
      <TextBox x:Name="SourceFolderTextBox" Text="{Binding SourceFolder, Mode=TwoWay}"
               Watermark="填写完整源文件夹路径" />
      <Button Content="⇅ 交换源与目标文件夹" Command="{Binding SwapCommand}"
              HorizontalAlignment="Center" Padding="14,6"
              ToolTip.Tip="一键交换合并方向，两个文件夹路径均保留并可以继续编辑。" />
      <TextBlock Text="目标文件夹（最终保留的目录）" FontWeight="SemiBold" />
      <TextBox x:Name="TargetFolderTextBox" Text="{Binding TargetFolder, Mode=TwoWay}"
               Watermark="填写现有目标文件夹或新目录路径" />
      <TextBlock Opacity="0.7" TextWrapping="Wrap"
                 Text="安全策略：先复制全部文件并用 SHA-256 校验，再更新 VDF 数据库，最后删除源文件。同名文件自动另存为“(VDF合并1)”且绝不覆盖；目标不存在会单独询问是否创建。可在下一步查看文件数量、容量与冲突数。" />
    </StackPanel>
  </DockPanel>
</Window>