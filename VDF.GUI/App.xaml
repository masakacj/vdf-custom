<Application
    x:Class="VDF.GUI.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:actipro="http://schemas.actiprosoftware.com/avaloniaui"
    xmlns:generation="clr-namespace:ActiproSoftware.UI.Avalonia.Themes.Generation;assembly=ActiproSoftware.Avalonia.Shared"
    xmlns:local="clr-namespace:VDF.GUI"
    xmlns:utils="clr-namespace:VDF.GUI.Utils"
    xmlns:vm="clr-namespace:VDF.GUI.ViewModels"
    RequestedThemeVariant="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="VdfGoodBrush" Color="#1C8A52" />
                    <SolidColorBrush x:Key="VdfGoodSoftBrush" Color="#E2F2E9" />
                    <SolidColorBrush x:Key="VdfGoodBorderBrush" Color="#731C8A52" />
                    <SolidColorBrush x:Key="VdfWarnBrush" Color="#A06A10" />
                    <SolidColorBrush x:Key="VdfWarnSoftBrush" Color="#F6ECD9" />
                    <SolidColorBrush x:Key="VdfWarnBorderBrush" Color="#73A06A10" />
                    <SolidColorBrush x:Key="VdfDangerBrush" Color="#BB4237" />
                    <SolidColorBrush x:Key="VdfDangerSoftBrush" Color="#F7E5E3" />
                    <SolidColorBrush x:Key="VdfDangerBorderBrush" Color="#73BB4237" />
                    <SolidColorBrush x:Key="VdfSelBrush" Color="#F9DFDA" />
                    <SolidColorBrush x:Key="VdfSelActiveBrush" Color="#F0BDB1" />
                    <SolidColorBrush x:Key="VdfTombBrush" Color="#A93B31" />
                    <SolidColorBrush x:Key="VdfMutedBrush" Color="#8A9793" />
                    <SolidColorBrush x:Key="VdfMutedSoftBrush" Color="#F7FAF9" />
                    <SolidColorBrush x:Key="VdfMutedBorderBrush" Color="#DBE3E0" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="VdfGoodBrush" Color="#45B878" />
                    <SolidColorBrush x:Key="VdfGoodSoftBrush" Color="#17301F" />
                    <SolidColorBrush x:Key="VdfGoodBorderBrush" Color="#7345B878" />
                    <SolidColorBrush x:Key="VdfWarnBrush" Color="#D29A3A" />
                    <SolidColorBrush x:Key="VdfWarnSoftBrush" Color="#33260E" />
                    <SolidColorBrush x:Key="VdfWarnBorderBrush" Color="#73D29A3A" />
                    <SolidColorBrush x:Key="VdfDangerBrush" Color="#E06A5E" />
                    <SolidColorBrush x:Key="VdfDangerSoftBrush" Color="#391914" />
                    <SolidColorBrush x:Key="VdfDangerBorderBrush" Color="#73E06A5E" />
                    <SolidColorBrush x:Key="VdfSelBrush" Color="#43221B" />
                    <SolidColorBrush x:Key="VdfSelActiveBrush" Color="#6E392B" />
                    <SolidColorBrush x:Key="VdfTombBrush" Color="#C05248" />
                    <SolidColorBrush x:Key="VdfMutedBrush" Color="#6D7B76" />
                    <SolidColorBrush x:Key="VdfMutedSoftBrush" Color="#1C2422" />
                    <SolidColorBrush x:Key="VdfMutedBorderBrush" Color="#2A3330" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.DataTemplates>
        <DataTemplate DataType="vm:ResultsViewSwitcherRow">
            <Border
                Padding="10,7"
                Background="{actipro:ThemeResource Container1BackgroundBrush}"
                BorderBrush="{actipro:ThemeResource Container3BorderBrush}"
                BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="{Binding Label}" />
                        <ComboBox
                            MinWidth="150"
                            FontSize="12"
                            ItemsSource="{Binding Options}"
                            SelectedItem="{Binding Selected}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ResultsDisplayModeOption">
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <StackPanel
                            IsVisible="{Binding ShowFolderMatchThreshold}"
                            Orientation="Horizontal"
                            Spacing="5"
                            VerticalAlignment="Center"
                            ToolTip.Tip="{Binding FolderMatchTip}">
                            <TextBlock VerticalAlignment="Center" FontSize="11.5" Text="{Binding FolderMatchLabel}" />
                            <NumericUpDown
                                Width="82"
                                Minimum="0"
                                Maximum="100"
                                Increment="5"
                                FormatString="0.#"
                                Value="{Binding FolderMatchThresholdPercent, Mode=TwoWay}" />
                            <TextBlock VerticalAlignment="Center" FontSize="11.5" Text="%" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel
                        DockPanel.Dock="Right"
                        Margin="12,0,0,0"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center"
                        IsVisible="{Binding ShowConsolidateControls}">
                        <TextBlock VerticalAlignment="Center" FontSize="11.5" Opacity="0.7" Text="{Binding SelectedSeriesText}" />
                        <Button
                            Classes="accent"
                            Padding="12,5"
                            FontSize="12"
                            IsEnabled="{Binding CanConsolidate}"
                            Command="{Binding ConsolidateSelectedCommand}"
                            Content="合并所选文件夹" />
                    </StackPanel>
                    <TextBlock
                        Margin="14,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="11.5"
                        Opacity="0.65"
                        TextWrapping="Wrap"
                        Text="{Binding Hint}" />
                </DockPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="vm:ResourceRelationHeader">
            <Border
                Margin="8,10,8,2"
                Padding="14,12"
                CornerRadius="9"
                Background="{actipro:ThemeResource Container2BackgroundBrush}"
                BorderBrush="{actipro:ThemeResource Container3BorderBrush}"
                BorderThickness="1">
                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="7">
                            <Border Padding="7,2" CornerRadius="5" BorderThickness="1" BorderBrush="{DynamicResource VdfGoodBorderBrush}" Background="{DynamicResource VdfGoodSoftBrush}">
                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource VdfGoodBrush}" Text="{Binding ActionLabel}" />
                            </Border>
                            <Button Padding="10,3" FontSize="11.5" Command="{Binding PreviewConsolidationCommand}" Content="预览合并" />
                        </StackPanel>
                        <CheckBox DockPanel.Dock="Left" Margin="0,0,9,0" VerticalAlignment="Center" IsChecked="{Binding IsSelected, Mode=TwoWay}" ToolTip.Tip="选择此文件夹关系参加批量合并；不会改变普通文件删除勾选" />
                        <StackPanel>
                            <TextBlock FontSize="13.5" FontWeight="SemiBold" Text="文件夹合并候选" />
                            <TextBlock FontSize="10.8" Opacity="0.58" Text="比较整棵系列目录，不把日期/主题子目录拆成独立关系" />
                        </StackPanel>
                    </DockPanel>

                    <Grid Grid.Row="1" ColumnDefinitions="*,126,*" ColumnSpacing="10">
                        <Border Padding="11" CornerRadius="7" BorderBrush="{DynamicResource VdfMutedBorderBrush}" BorderThickness="1">
                            <StackPanel Spacing="5">
                                <TextBlock FontSize="10.5" Opacity="0.58" Text="{Binding TargetRoleLabel}" />
                                <TextBlock FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding TargetFolder}" />
                                <TextBlock FontSize="11.3" Opacity="0.74" TextWrapping="Wrap" Text="{Binding TargetMeta}" />
                            </StackPanel>
                        </Border>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="3">
                            <TextBlock HorizontalAlignment="Center" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource VdfGoodBrush}" Text="{Binding OverlapText}" />
                            <TextBlock HorizontalAlignment="Center" FontSize="10.5" Opacity="0.62" Text="{Binding OverlapCaption}" />
                            <TextBlock HorizontalAlignment="Center" FontSize="15" Opacity="0.55" Text="⇄" />
                        </StackPanel>
                        <Border Grid.Column="2" Padding="11" CornerRadius="7" BorderBrush="{DynamicResource VdfMutedBorderBrush}" BorderThickness="1">
                            <StackPanel Spacing="5">
                                <TextBlock FontSize="10.5" Opacity="0.58" Text="{Binding SourceRoleLabel}" />
                                <TextBlock FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding SourceFolder}" />
                                <TextBlock FontSize="11.3" Opacity="0.74" TextWrapping="Wrap" Text="{Binding SourceMeta}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <DockPanel Grid.Row="2" LastChildFill="True">
                        <TextBlock DockPanel.Dock="Right" Margin="14,0,0,0" FontSize="11" Opacity="0.68" Text="{Binding BestReadinessText}" />
                        <TextBlock FontSize="11" FontWeight="SemiBold" Text="{Binding CoverageText}" />
                        <TextBlock Margin="12,0,0,0" FontSize="10.8" Opacity="0.58" TextWrapping="Wrap" Text="{Binding ActionHint}" />
                    </DockPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="vm:ResourceUnassignedHeader">
            <Border
                Margin="0,8,0,0"
                Padding="12,8"
                Background="{actipro:ThemeResource Container2BackgroundBrush}"
                BorderBrush="{actipro:ThemeResource Container3BorderBrush}"
                BorderThickness="0,1,0,1">
                <StackPanel Spacing="3">
                    <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding Title}" />
                    <TextBlock FontSize="11.5" Opacity="0.7" TextWrapping="Wrap" Text="{Binding Summary}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <actipro:ModernTheme>
            <actipro:ModernTheme.Definition>
                <generation:ThemeDefinition AccentColorRampName="VdfTeal">
                    <generation:ThemeDefinition.ColorPaletteFactory>
                        <utils:VdfColorPaletteFactory />
                    </generation:ThemeDefinition.ColorPaletteFactory>
                </generation:ThemeDefinition>
            </actipro:ModernTheme.Definition>
        </actipro:ModernTheme>
        <StyleInclude Source="avares://VDF.GUI/Styles/Styles.xaml" />
    </Application.Styles>
</Application>